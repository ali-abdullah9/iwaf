# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (required for request logging and the DRE)
MONGODB_URI=<your-mongodb-connection-string>
MONGO_DB=waf_db

# Anthropic API key for LLM-assisted rule synthesis (optional; the DRE falls
# back to Ollama or a heuristic provider when it is not set)
ANTHROPIC_API_KEY=<your-anthropic-api-key>
LLM_MODEL=claude-haiku-4-5-20251001
LLM_PREFERENCE=auto

# Service settings
SERVICE_HOST=0.0.0.0
SERVICE_PORT=5000
CONFIDENCE_THRESHOLD=0.70
LOG_LEVEL=INFO
